@startuml 04-secuencia-reserva-pago
!include _estilo.iuml
autonumber
title Diagrama de secuencia — Reserva directa y pago (modelo A: cobro en la cuenta del tutor)

actor "Estudiante" as E
participant "Frontend\n(Next.js)" as FE
participant "ReservaController" as RC
participant "ReservaService" as RS
participant "PagoController" as PC
participant "PagoService" as PS
participant "MercadoPago" as MP
participant "MercadoPagoWebhook\nController" as WH
participant "EscrowService" as ES
participant "SesionService\n(M3)" as SS
database "PostgreSQL" as DB

E -> FE : elige tutor, horario, duración\ny (opcional) adicional de resumen
FE -> RC : POST /api/reservas
RC -> RS : crearDirecta(pagador, request)
RS -> RS : validar ventana mínima, franja, tutor\nreservable y cuenta MP del tutor conectada
RS -> DB : INSERT reserva (pendiente_pago,\nprecio congelado)
RS -> RS : agendar timeout de pago (15 min, Quartz)
RS --> RC : Reserva
RC --> FE : 201 ReservaResponse
FE -> PC : POST /api/pagos/preferencia
PC -> PS : generarPreferencia(usuario, reservaId)
PS -> PS : exigir pagador y calcular comisión
PS -> MP : crearPreferencia(monto, marketplace_fee,\nexternal_reference = reservaId)\ncon el token OAuth del tutor
MP --> PS : preferenceId, initPoint
PS -> DB : registrar preferencia (conciliación)
PS --> FE : initPoint
FE -> MP : redirigir al checkout
E -> MP : paga (el dinero entra a la\ncuenta del tutor, menos marketplace_fee)
MP ->> WH : POST /api/webhooks/mercadopago\n(firmado)
WH -> WH : verificar firma HMAC y\nresolver el token del tutor (user_id)
WH -> ES : procesarPagoAprobado(mpPaymentId, tokenTutor)
ES -> MP : consultar el pago (cliente HTTP propio)
MP --> ES : aprobado, monto, external_reference
ES -> DB : SELECT reserva FOR UPDATE
alt reserva pendiente_pago y monto coincide
  ES -> DB : INSERT transaccion (retenido_escrow)
  ES -> RS : confirmarPagoSimulado(reservaId)
  RS -> DB : UPDATE reserva → confirmada
  RS -> RS : cancelar timeout de pago
  RS ->> SS : ReservaConfirmadaEvent
  SS -> DB : INSERT sesion (no_iniciada)
  SS -> SS : agendar jobs T−5, T+10, fin + 5
else reserva ya no está pendiente
  ES -> MP : reembolsar pago tardío
else monto distinto
  ES --> WH : PagoInconsistenteException (fail-closed)
end
WH --> MP : 200 OK
MP --> FE : retorno (back_url)
FE -> PC : POST /api/pagos/confirmar-retorno
PC -> ES : confirmarDesdeRetorno() (idempotente)
FE --> E : "Reserva confirmada"
note over ES, DB
  Si no llegan ni el webhook ni el retorno,
  ConciliacionPagosJob busca el pago por
  external_reference y sigue el mismo camino.
end note
@enduml
