digraph "pagos" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.9, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#333333", dir=both, arrowsize=0.9];
  "pagos.cuentas_mp_tutor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>cuentas_mp_tutor</B></TD></TR><TR><TD ALIGN="LEFT"><U>tutor_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 8 atributos</I></FONT></TD></TR></TABLE>>];
  "pagos.oauth_estados" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>oauth_estados</B></TD></TR><TR><TD ALIGN="LEFT"><U>state</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 2 atributos</I></FONT></TD></TR></TABLE>>];
  "pagos.pasarela_estado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>pasarela_estado</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 2 atributos</I></FONT></TD></TR></TABLE>>];
  "pagos.precios_referencia_regional" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>precios_referencia_regional</B></TD></TR><TR><TD ALIGN="LEFT"><U>provincia</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><U>version</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 2 atributos</I></FONT></TD></TR></TABLE>>];
  "pagos.preferencias_pago" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>preferencias_pago</B></TD></TR><TR><TD ALIGN="LEFT"><U>reserva_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 5 atributos</I></FONT></TD></TR></TABLE>>];
  "pagos.tarifas_tutor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>tarifas_tutor</B></TD></TR><TR><TD ALIGN="LEFT"><U>tutor_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 4 atributos</I></FONT></TD></TR></TABLE>>];
  "pagos.transacciones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>transacciones</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reserva_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">mp_payment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">UQ</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 15 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.usuarios" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="identidad.usuarios"];
  "reservas.reservas" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="reservas.reservas"];
  "pagos.cuentas_mp_tutor" -> "identidad.usuarios" [arrowtail=teeodot, arrowhead=teetee, label="tutor_id"];
  "pagos.oauth_estados" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="tutor_id"];
  "pagos.pasarela_estado" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teeodot, label="updated_by"];
  "pagos.preferencias_pago" -> "reservas.reservas" [arrowtail=teeodot, arrowhead=teetee, label="reserva_id"];
  "pagos.tarifas_tutor" -> "identidad.usuarios" [arrowtail=teeodot, arrowhead=teetee, label="tutor_id"];
  "pagos.transacciones" -> "reservas.reservas" [arrowtail=teeodot, arrowhead=teetee, label="reserva_id"];
}
