digraph "admin" {
  graph [fontname="Helvetica", rankdir=TB, nodesep=0.35, ranksep=0.9, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#333333", dir=both, arrowsize=0.9];
  "admin.admins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>admins</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, UQ</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "admin.log_auditoria_admin" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>log_auditoria_admin</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">admin_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 5 atributos</I></FONT></TD></TR></TABLE>>];
  "admin.mapeo_origen_rol" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>mapeo_origen_rol</B></TD></TR><TR><TD ALIGN="LEFT"><U>origen_modulo</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 1 atributo</I></FONT></TD></TR></TABLE>>];
  "admin.notificaciones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>notificaciones</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">destinatario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 8 atributos</I></FONT></TD></TR></TABLE>>];
  "admin.nps_respuestas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>nps_respuestas</B></TD></TR><TR><TD ALIGN="LEFT"><U>usuario_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 2 atributos</I></FONT></TD></TR></TABLE>>];
  "admin.tickets_soporte" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>tickets_soporte</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">origen_modulo</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 6 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.usuarios" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="identidad.usuarios"];
  "admin.admins" -> "identidad.usuarios" [arrowtail=teeodot, arrowhead=teetee, label="usuario_id"];
  "admin.log_auditoria_admin" -> "admin.admins" [arrowtail=crowodot, arrowhead=teetee, label="admin_id"];
  "admin.notificaciones" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="destinatario_id"];
  "admin.nps_respuestas" -> "identidad.usuarios" [arrowtail=teeodot, arrowhead=teetee, label="usuario_id"];
  "admin.tickets_soporte" -> "admin.mapeo_origen_rol" [arrowtail=crowodot, arrowhead=teetee, label="origen_modulo"];
  "admin.tickets_soporte" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="usuario_id"];
  "admin.log_auditoria_admin" -> "admin.tickets_soporte" [style=invis, dir=none];
}
