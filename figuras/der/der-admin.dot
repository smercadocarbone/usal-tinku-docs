digraph "admin" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.2, ranksep=0.7, splines=spline, pad=0.1];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#444444", arrowsize=0.8, penwidth=0.8];
  "admin.admins" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ededed" colspan="2" align="center"><b>admins</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="usuario_id">usuario_id</td><td align="left"><font color="#555555">uuid FK UQ</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "admin.log_auditoria_admin" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ededed" colspan="2" align="center"><b>log_auditoria_admin</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="admin_id">admin_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 5 atributos</i></font></td></tr></table>>];
  "admin.mapeo_origen_rol" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ededed" colspan="2" align="center"><b>mapeo_origen_rol</b></td></tr><tr><td align="left" port="origen_modulo"><u>origen_modulo</u></td><td align="left"><font color="#555555">varchar(60) PK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 1 atributo</i></font></td></tr></table>>];
  "admin.notificaciones" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ededed" colspan="2" align="center"><b>notificaciones</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="destinatario_id">destinatario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 8 atributos</i></font></td></tr></table>>];
  "admin.nps_respuestas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ededed" colspan="2" align="center"><b>nps_respuestas</b></td></tr><tr><td align="left" port="usuario_id"><u>usuario_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 2 atributos</i></font></td></tr></table>>];
  "admin.tickets_soporte" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ededed" colspan="2" align="center"><b>tickets_soporte</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="usuario_id">usuario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="origen_modulo">origen_modulo</td><td align="left"><font color="#555555">varchar(60) FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 6 atributos</i></font></td></tr></table>>];
  "identidad.usuarios#admins" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#notificaciones" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#nps_respuestas" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#tickets_soporte" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "admin.admins":"usuario_id" -> "identidad.usuarios#admins" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "admin.log_auditoria_admin":"admin_id" -> "admin.admins" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "admin.notificaciones":"destinatario_id" -> "identidad.usuarios#notificaciones" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "admin.nps_respuestas":"usuario_id" -> "identidad.usuarios#nps_respuestas" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "admin.tickets_soporte":"origen_modulo" -> "admin.mapeo_origen_rol" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "admin.tickets_soporte":"usuario_id" -> "identidad.usuarios#tickets_soporte" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
}
