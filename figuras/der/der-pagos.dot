digraph "pagos" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.2, ranksep=0.7, splines=spline, pad=0.1];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#444444", arrowsize=0.8, penwidth=0.8];
  "pagos.cuentas_mp_tutor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ead1dc" colspan="2" align="center"><b>cuentas_mp_tutor</b></td></tr><tr><td align="left" port="tutor_id"><u>tutor_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 8 atributos</i></font></td></tr></table>>];
  "pagos.oauth_estados" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ead1dc" colspan="2" align="center"><b>oauth_estados</b></td></tr><tr><td align="left" port="state"><u>state</u></td><td align="left"><font color="#555555">varchar(64) PK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 2 atributos</i></font></td></tr></table>>];
  "pagos.pasarela_estado" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ead1dc" colspan="2" align="center"><b>pasarela_estado</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">smallint PK</font></td></tr><tr><td align="left" port="updated_by"><i>updated_by</i></td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 2 atributos</i></font></td></tr></table>>];
  "pagos.precios_referencia_regional" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ead1dc" colspan="2" align="center"><b>precios_referencia_regional</b></td></tr><tr><td align="left" port="provincia"><u>provincia</u></td><td align="left"><font color="#555555">varchar PK</font></td></tr><tr><td align="left" port="version"><u>version</u></td><td align="left"><font color="#555555">integer PK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 2 atributos</i></font></td></tr></table>>];
  "pagos.preferencias_pago" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ead1dc" colspan="2" align="center"><b>preferencias_pago</b></td></tr><tr><td align="left" port="reserva_id"><u>reserva_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 5 atributos</i></font></td></tr></table>>];
  "pagos.tarifas_tutor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ead1dc" colspan="2" align="center"><b>tarifas_tutor</b></td></tr><tr><td align="left" port="tutor_id"><u>tutor_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 4 atributos</i></font></td></tr></table>>];
  "pagos.transacciones" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ead1dc" colspan="2" align="center"><b>transacciones</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="reserva_id">reserva_id</td><td align="left"><font color="#555555">uuid FK UQ</font></td></tr><tr><td align="left" port="mp_payment_id">mp_payment_id</td><td align="left"><font color="#555555">varchar UQ</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 15 atributos</i></font></td></tr></table>>];
  "identidad.usuarios#cuentas_mp_tutor" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#oauth_estados" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#pasarela_estado" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#tarifas_tutor" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "reservas.reservas#preferencias_pago" [shape=box, style="rounded,filled,dashed", fillcolor="#fff2cc", label="reservas.\nreservas"];
  "reservas.reservas#transacciones" [shape=box, style="rounded,filled,dashed", fillcolor="#fff2cc", label="reservas.\nreservas"];
  "pagos.cuentas_mp_tutor":"tutor_id" -> "identidad.usuarios#cuentas_mp_tutor" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "pagos.oauth_estados":"tutor_id" -> "identidad.usuarios#oauth_estados" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "pagos.pasarela_estado":"updated_by" -> "identidad.usuarios#pasarela_estado" [dir=both, arrowtail="crowodot", arrowhead="teeodot"];
  "pagos.preferencias_pago":"reserva_id" -> "reservas.reservas#preferencias_pago" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "pagos.tarifas_tutor":"tutor_id" -> "identidad.usuarios#tarifas_tutor" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "pagos.transacciones":"reserva_id" -> "reservas.reservas#transacciones" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
}
