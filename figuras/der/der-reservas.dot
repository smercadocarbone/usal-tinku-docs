digraph "reservas" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.2, ranksep=0.7, splines=spline, pad=0.1];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#444444", arrowsize=0.8, penwidth=0.8];
  "reservas.franjas_disponibilidad" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#fff2cc" colspan="2" align="center"><b>franjas_disponibilidad</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 5 atributos</i></font></td></tr></table>>];
  "reservas.notas_clase" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#fff2cc" colspan="2" align="center"><b>notas_clase</b></td></tr><tr><td align="left" port="reserva_id"><u>reserva_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "reservas.paquetes" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#fff2cc" colspan="2" align="center"><b>paquetes</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="pagador_id">pagador_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="beneficiario_id">beneficiario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="reserva_ancla_id"><i>reserva_ancla_id</i></td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 7 atributos</i></font></td></tr></table>>];
  "reservas.pedidos_previos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#fff2cc" colspan="2" align="center"><b>pedidos_previos</b></td></tr><tr><td align="left" port="reserva_id"><u>reserva_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "reservas.pedidos_reprogramacion" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#fff2cc" colspan="2" align="center"><b>pedidos_reprogramacion</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="reserva_id">reserva_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 6 atributos</i></font></td></tr></table>>];
  "reservas.reservas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#fff2cc" colspan="2" align="center"><b>reservas</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="pagador_id">pagador_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="beneficiario_id">beneficiario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="solicitud_origen_id"><i>solicitud_origen_id</i></td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="paquete_id"><i>paquete_id</i></td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 9 atributos</i></font></td></tr></table>>];
  "reservas.solicitudes_sesion" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#fff2cc" colspan="2" align="center"><b>solicitudes_sesion</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="menor_id">menor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 5 atributos</i></font></td></tr></table>>];
  "identidad.usuarios#franjas_disponibilidad" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#paquetes" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#reservas" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#solicitudes_sesion" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "reservas.franjas_disponibilidad":"tutor_id" -> "identidad.usuarios#franjas_disponibilidad" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.notas_clase":"reserva_id" -> "reservas.reservas" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "reservas.paquetes":"reserva_ancla_id" -> "reservas.reservas" [dir=both, arrowtail="crowodot", arrowhead="teeodot"];
  "reservas.paquetes":"beneficiario_id" -> "identidad.usuarios#paquetes" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.paquetes":"pagador_id" -> "identidad.usuarios#paquetes" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.paquetes":"tutor_id" -> "identidad.usuarios#paquetes" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.pedidos_previos":"reserva_id" -> "reservas.reservas" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "reservas.pedidos_reprogramacion":"reserva_id" -> "reservas.reservas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.reservas":"beneficiario_id" -> "identidad.usuarios#reservas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.reservas":"pagador_id" -> "identidad.usuarios#reservas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.reservas":"paquete_id" -> "reservas.paquetes" [dir=both, arrowtail="crowodot", arrowhead="teeodot"];
  "reservas.reservas":"solicitud_origen_id" -> "reservas.solicitudes_sesion" [dir=both, arrowtail="crowodot", arrowhead="teeodot"];
  "reservas.reservas":"tutor_id" -> "identidad.usuarios#reservas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.solicitudes_sesion":"menor_id" -> "identidad.usuarios#solicitudes_sesion" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reservas.solicitudes_sesion":"tutor_id" -> "identidad.usuarios#solicitudes_sesion" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
}
