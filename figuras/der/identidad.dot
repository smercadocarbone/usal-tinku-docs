digraph "identidad" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.9, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#333333", dir=both, arrowsize=0.9];
  "identidad.aceptaciones_clausula" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>aceptaciones_clausula</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.autorizaciones_tutor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>autorizaciones_tutor</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">adulto_responsable_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">menor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 2 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.certificados_antecedentes_penales" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>certificados_antecedentes_penales</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 20 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.consentimientos_menor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>consentimientos_menor</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">menor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">adulto_responsable_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.credencial_especialidades" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>credencial_especialidades</B></TD></TR><TR><TD ALIGN="LEFT"><U>credencial_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><U>especialidad_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR></TABLE>>];
  "identidad.credenciales_academicas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>credenciales_academicas</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 17 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.especialidades_tutor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>especialidades_tutor</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.intentos_credencial" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>intentos_credencial</B></TD></TR><TR><TD ALIGN="LEFT"><U>tutor_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.intentos_ocr" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>intentos_ocr</B></TD></TR><TR><TD ALIGN="LEFT"><U>dni</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.tokens_reset_password" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>tokens_reset_password</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">UQ</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.usuarios" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>usuarios</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">dni</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">adulto_responsable_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 15 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.aceptaciones_clausula" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="usuario_id"];
  "identidad.autorizaciones_tutor" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="adulto_responsable_id\nmenor_id\ntutor_id"];
  "identidad.certificados_antecedentes_penales" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="tutor_id"];
  "identidad.consentimientos_menor" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="adulto_responsable_id\nmenor_id"];
  "identidad.credencial_especialidades" -> "identidad.credenciales_academicas" [arrowtail=crowodot, arrowhead=teetee, label="credencial_id"];
  "identidad.credencial_especialidades" -> "identidad.especialidades_tutor" [arrowtail=crowodot, arrowhead=teetee, label="especialidad_id"];
  "identidad.credenciales_academicas" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="tutor_id"];
  "identidad.especialidades_tutor" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="tutor_id"];
  "identidad.intentos_credencial" -> "identidad.usuarios" [arrowtail=teeodot, arrowhead=teetee, label="tutor_id"];
  "identidad.tokens_reset_password" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="usuario_id"];
  "identidad.usuarios" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teeodot, label="adulto_responsable_id"];
}
