digraph "matching" {
  graph [fontname="Helvetica", rankdir=TB, nodesep=0.35, ranksep=0.9, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#333333", dir=both, arrowsize=0.9];
  "matching.busquedas_guardadas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>busquedas_guardadas</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 4 atributos</I></FONT></TD></TR></TABLE>>];
  "matching.evaluacion_aceptaciones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>evaluacion_aceptaciones</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">busqueda_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "matching.evaluacion_busquedas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>evaluacion_busquedas</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 4 atributos</I></FONT></TD></TR></TABLE>>];
  "matching.materias_niveles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>materias_niveles</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 2 atributos</I></FONT></TD></TR></TABLE>>];
  "matching.perfiles_tutor_matching" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>perfiles_tutor_matching</B></TD></TR><TR><TD ALIGN="LEFT"><U>tutor_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 4 atributos</I></FONT></TD></TR></TABLE>>];
  "matching.temas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>temas</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">trayecto_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 5 atributos</I></FONT></TD></TR></TABLE>>];
  "matching.temas_sugeridos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>temas_sugeridos</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">texto</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">UQ</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 4 atributos</I></FONT></TD></TR></TABLE>>];
  "matching.trayectos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>trayectos</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.usuarios" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="identidad.usuarios"];
  "matching.busquedas_guardadas" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="usuario_id"];
  "matching.evaluacion_aceptaciones" -> "matching.evaluacion_busquedas" [arrowtail=crowodot, arrowhead=teetee, label="busqueda_id"];
  "matching.evaluacion_aceptaciones" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="tutor_id"];
  "matching.evaluacion_busquedas" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="usuario_id"];
  "matching.perfiles_tutor_matching" -> "identidad.usuarios" [arrowtail=teeodot, arrowhead=teetee, label="tutor_id"];
  "matching.temas" -> "matching.trayectos" [arrowtail=crowodot, arrowhead=teetee, label="trayecto_id"];
  "matching.busquedas_guardadas" -> "matching.materias_niveles" [style=invis, dir=none];
  "matching.evaluacion_aceptaciones" -> "matching.perfiles_tutor_matching" [style=invis, dir=none];
  "matching.materias_niveles" -> "matching.temas" [style=invis, dir=none];
  "matching.perfiles_tutor_matching" -> "matching.temas_sugeridos" [style=invis, dir=none];
}
