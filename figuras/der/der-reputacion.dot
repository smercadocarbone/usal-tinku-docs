digraph "reputacion" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.2, ranksep=0.7, splines=spline, pad=0.1];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#444444", arrowsize=0.8, penwidth=0.8];
  "reputacion.calificaciones" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ddebf7" colspan="2" align="center"><b>calificaciones</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="sesion_id">sesion_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="autor_id">autor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 5 atributos</i></font></td></tr></table>>];
  "reputacion.senales_implicitas_tutor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#ddebf7" colspan="2" align="center"><b>senales_implicitas_tutor</b></td></tr><tr><td align="left" port="tutor_id"><u>tutor_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 6 atributos</i></font></td></tr></table>>];
  "aula.sesiones_aprendizaje#calificaciones" [shape=box, style="rounded,filled,dashed", fillcolor="#fde9d9", label="aula.\nsesiones_aprendizaje"];
  "identidad.usuarios#calificaciones" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#senales_implicitas_tutor" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "reputacion.calificaciones":"autor_id" -> "identidad.usuarios#calificaciones" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reputacion.calificaciones":"sesion_id" -> "aula.sesiones_aprendizaje#calificaciones" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "reputacion.senales_implicitas_tutor":"tutor_id" -> "identidad.usuarios#senales_implicitas_tutor" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
}
