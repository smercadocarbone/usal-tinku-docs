digraph "identidad" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.2, ranksep=0.7, splines=spline, pad=0.1];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#444444", arrowsize=0.8, penwidth=0.8];
  "identidad.aceptaciones_clausula" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>aceptaciones_clausula</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="usuario_id">usuario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "identidad.autorizaciones_tutor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>autorizaciones_tutor</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="adulto_responsable_id">adulto_responsable_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="menor_id">menor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 2 atributos</i></font></td></tr></table>>];
  "identidad.certificados_antecedentes_penales" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>certificados_antecedentes_penales</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 20 atributos</i></font></td></tr></table>>];
  "identidad.consentimientos_menor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>consentimientos_menor</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="menor_id">menor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="adulto_responsable_id">adulto_responsable_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "identidad.credencial_especialidades" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>credencial_especialidades</b></td></tr><tr><td align="left" port="credencial_id"><u>credencial_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td align="left" port="especialidad_id"><u>especialidad_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr></table>>];
  "identidad.credenciales_academicas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>credenciales_academicas</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 17 atributos</i></font></td></tr></table>>];
  "identidad.especialidades_tutor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>especialidades_tutor</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "identidad.intentos_credencial" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>intentos_credencial</b></td></tr><tr><td align="left" port="tutor_id"><u>tutor_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "identidad.intentos_ocr" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>intentos_ocr</b></td></tr><tr><td align="left" port="dni"><u>dni</u></td><td align="left"><font color="#555555">varchar(20) PK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "identidad.tokens_reset_password" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>tokens_reset_password</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="usuario_id">usuario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="token_hash">token_hash</td><td align="left"><font color="#555555">varchar(64) UQ</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "identidad.usuarios" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#dbe9f6" colspan="2" align="center"><b>usuarios</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="dni">dni</td><td align="left"><font color="#555555">varchar(20) UQ</font></td></tr><tr><td align="left" port="adulto_responsable_id"><i>adulto_responsable_id</i></td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 15 atributos</i></font></td></tr></table>>];
  "identidad.aceptaciones_clausula":"usuario_id" -> "identidad.usuarios" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.usuarios" -> "identidad.autorizaciones_tutor":"adulto_responsable_id" [dir=both, arrowtail="teetee", arrowhead="crowodot"];
  "identidad.autorizaciones_tutor":"menor_id" -> "identidad.usuarios" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.usuarios" -> "identidad.autorizaciones_tutor":"tutor_id" [dir=both, arrowtail="teetee", arrowhead="crowodot"];
  "identidad.certificados_antecedentes_penales":"tutor_id" -> "identidad.usuarios" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.usuarios" -> "identidad.consentimientos_menor":"adulto_responsable_id" [dir=both, arrowtail="teetee", arrowhead="crowodot"];
  "identidad.consentimientos_menor":"menor_id" -> "identidad.usuarios" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.credencial_especialidades":"credencial_id" -> "identidad.credenciales_academicas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.credencial_especialidades":"especialidad_id" -> "identidad.especialidades_tutor" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.usuarios" -> "identidad.credenciales_academicas":"tutor_id" [dir=both, arrowtail="teetee", arrowhead="crowodot"];
  "identidad.especialidades_tutor":"tutor_id" -> "identidad.usuarios" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.usuarios" -> "identidad.intentos_credencial":"tutor_id" [dir=both, arrowtail="teetee", arrowhead="teeodot"];
  "identidad.tokens_reset_password":"usuario_id" -> "identidad.usuarios" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "identidad.usuarios":"adulto_responsable_id":w -> "identidad.usuarios":"id":w [dir=both, arrowtail="crowodot", arrowhead="teeodot"];
}
