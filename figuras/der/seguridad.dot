digraph "seguridad" {
  graph [fontname="Helvetica", rankdir=TB, nodesep=0.35, ranksep=0.9, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#333333", dir=both, arrowsize=0.9];
  "seguridad.denuncias" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>denuncias</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">denunciante_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">denunciado_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">sesion_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">admin_resolutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 11 atributos</I></FONT></TD></TR></TABLE>>];
  "seguridad.sanciones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>sanciones</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">usuario_sancionado_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">denuncia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">alerta_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">admin_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 6 atributos</I></FONT></TD></TR></TABLE>>];
  "aula.alertas_seguridad" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="aula.alertas_seguridad"];
  "aula.sesiones_aprendizaje" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="aula.sesiones_aprendizaje"];
  "identidad.usuarios" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="identidad.usuarios"];
  "seguridad.denuncias" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teeodot, label="admin_resolutor_id"];
  "seguridad.denuncias" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="denunciado_id"];
  "seguridad.denuncias" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="denunciante_id"];
  "seguridad.denuncias" -> "aula.sesiones_aprendizaje" [arrowtail=crowodot, arrowhead=teeodot, label="sesion_id"];
  "seguridad.sanciones" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="admin_id\nusuario_sancionado_id"];
  "seguridad.sanciones" -> "aula.alertas_seguridad" [arrowtail=crowodot, arrowhead=teeodot, label="alerta_id"];
  "seguridad.sanciones" -> "seguridad.denuncias" [arrowtail=crowodot, arrowhead=teeodot, label="denuncia_id"];
}
