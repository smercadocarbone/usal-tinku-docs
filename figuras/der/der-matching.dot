digraph "matching" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.2, ranksep=0.7, splines=spline, pad=0.1];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#444444", arrowsize=0.8, penwidth=0.8];
  "matching.busquedas_guardadas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>busquedas_guardadas</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="usuario_id">usuario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 4 atributos</i></font></td></tr></table>>];
  "matching.evaluacion_aceptaciones" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>evaluacion_aceptaciones</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="busqueda_id">busqueda_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td align="left" port="tutor_id">tutor_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "matching.evaluacion_busquedas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>evaluacion_busquedas</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="usuario_id">usuario_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 4 atributos</i></font></td></tr></table>>];
  "matching.materias_niveles" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>materias_niveles</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 2 atributos</i></font></td></tr></table>>];
  "matching.perfiles_tutor_matching" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>perfiles_tutor_matching</b></td></tr><tr><td align="left" port="tutor_id"><u>tutor_id</u></td><td align="left"><font color="#555555">uuid PK FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 4 atributos</i></font></td></tr></table>>];
  "matching.temas" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>temas</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="trayecto_id">trayecto_id</td><td align="left"><font color="#555555">uuid FK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 5 atributos</i></font></td></tr></table>>];
  "matching.temas_sugeridos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>temas_sugeridos</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td align="left" port="texto">texto</td><td align="left"><font color="#555555">text UQ</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 4 atributos</i></font></td></tr></table>>];
  "matching.trayectos" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="2"><tr><td bgcolor="#e2f0d9" colspan="2" align="center"><b>trayectos</b></td></tr><tr><td align="left" port="id"><u>id</u></td><td align="left"><font color="#555555">uuid PK</font></td></tr><tr><td colspan="2" align="left"><font color="#555555" point-size="8"><i>+ 3 atributos</i></font></td></tr></table>>];
  "identidad.usuarios#busquedas_guardadas" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#evaluacion_aceptaciones" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#evaluacion_busquedas" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "identidad.usuarios#perfiles_tutor_matching" [shape=box, style="rounded,filled,dashed", fillcolor="#dbe9f6", label="identidad.\nusuarios"];
  "matching.busquedas_guardadas":"usuario_id" -> "identidad.usuarios#busquedas_guardadas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "matching.evaluacion_aceptaciones":"busqueda_id" -> "matching.evaluacion_busquedas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "matching.evaluacion_aceptaciones":"tutor_id" -> "identidad.usuarios#evaluacion_aceptaciones" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "matching.evaluacion_busquedas":"usuario_id" -> "identidad.usuarios#evaluacion_busquedas" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
  "matching.perfiles_tutor_matching":"tutor_id" -> "identidad.usuarios#perfiles_tutor_matching" [dir=both, arrowtail="teeodot", arrowhead="teetee"];
  "matching.temas":"trayecto_id" -> "matching.trayectos" [dir=both, arrowtail="crowodot", arrowhead="teetee"];
}
