digraph "reservas" {
  graph [fontname="Helvetica", rankdir=TB, nodesep=0.35, ranksep=0.9, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#333333", dir=both, arrowsize=0.9];
  "reservas.franjas_disponibilidad" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>franjas_disponibilidad</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 5 atributos</I></FONT></TD></TR></TABLE>>];
  "reservas.notas_clase" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>notas_clase</B></TD></TR><TR><TD ALIGN="LEFT"><U>reserva_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "reservas.paquetes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>paquetes</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">pagador_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">beneficiario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">reserva_ancla_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 7 atributos</I></FONT></TD></TR></TABLE>>];
  "reservas.pedidos_previos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>pedidos_previos</B></TD></TR><TR><TD ALIGN="LEFT"><U>reserva_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK, PK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  "reservas.pedidos_reprogramacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>pedidos_reprogramacion</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">reserva_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 6 atributos</I></FONT></TD></TR></TABLE>>];
  "reservas.reservas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>reservas</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">pagador_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">beneficiario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">solicitud_origen_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">paquete_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 9 atributos</I></FONT></TD></TR></TABLE>>];
  "reservas.solicitudes_sesion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5A9E"><TR><TD COLSPAN="2" BGCOLOR="#EEF3FB" ALIGN="CENTER"><B>solicitudes_sesion</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">menor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tutor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#2F5A9E">FK</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777"><I>+ 5 atributos</I></FONT></TD></TR></TABLE>>];
  "identidad.usuarios" [shape=box, style="dashed,rounded", color="#777777", fontcolor="#777777", label="identidad.usuarios"];
  "reservas.franjas_disponibilidad" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="tutor_id"];
  "reservas.notas_clase" -> "reservas.reservas" [arrowtail=teeodot, arrowhead=teetee, label="reserva_id"];
  "reservas.paquetes" -> "reservas.reservas" [arrowtail=crowodot, arrowhead=teeodot, label="reserva_ancla_id"];
  "reservas.paquetes" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="beneficiario_id\npagador_id\ntutor_id"];
  "reservas.pedidos_previos" -> "reservas.reservas" [arrowtail=teeodot, arrowhead=teetee, label="reserva_id"];
  "reservas.pedidos_reprogramacion" -> "reservas.reservas" [arrowtail=crowodot, arrowhead=teetee, label="reserva_id"];
  "reservas.reservas" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="beneficiario_id\npagador_id\ntutor_id"];
  "reservas.reservas" -> "reservas.paquetes" [arrowtail=crowodot, arrowhead=teeodot, label="paquete_id"];
  "reservas.reservas" -> "reservas.solicitudes_sesion" [arrowtail=crowodot, arrowhead=teeodot, label="solicitud_origen_id"];
  "reservas.solicitudes_sesion" -> "identidad.usuarios" [arrowtail=crowodot, arrowhead=teetee, label="menor_id\ntutor_id"];
  "reservas.franjas_disponibilidad" -> "reservas.pedidos_previos" [style=invis, dir=none];
  "reservas.notas_clase" -> "reservas.pedidos_reprogramacion" [style=invis, dir=none];
}
